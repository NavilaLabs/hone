{
  "name": "hone",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  },
  "mounts": [
    "source=hone-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=hone-target,target=${containerWorkspaceFolder}/target,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /usr/local/cargo/registry ${containerWorkspaceFolder}/target && rustup component add clippy rustfmt",
  "remoteUser": "vscode"
}
