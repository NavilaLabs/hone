{
  "protocol": 1,
  "ticket": {
    "path": "design/tickets/{ticket}/ticket.yaml"
  },
  "kinds": {
    "decision": {
      "path": "design/decisions/{id}-{slug}.md",
      "id_prefix": "dec",
      "lifecycle": "decided",
      "statuses": {
        "proposed": {
          "binding": false
        },
        "accepted": {
          "binding": true
        }
      },
      "x-set-by": "b",
      "x-set-by-c-and-a": "a",
      "x-set-by-c": "c"
    }
  },
  "roles": {
    "human": {
      "kind": "human",
      "can": ["act", "comment", "approve"]
    },
    "critic": {
      "kind": "ai",
      "can": ["act", "comment"]
    }
  },
  "actors": {},
  "steps": {
    "decision": {
      "acts": ["human", "critic"],
      "decides": "human",
      "inputs": ["ticket"],
      "outputs": ["decision"],
      "requires": [],
      "gates": {
        "exists": {
          "gate": "artifact-exists",
          "params": {
            "type": "decision"
          }
        },
        "approved": {
          "gate": "approvals-valid",
          "params": {
            "role": "human"
          }
        }
      }
    }
  },
  "profiles": {
    "standard": {
      "steps": {
        "decision": "required"
      },
      "retention": "archive",
      "review_summary": "full"
    }
  },
  "select": {
    "rules": [],
    "default": "standard"
  }
}
