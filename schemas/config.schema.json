{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hone.invalid/schema/1/config.schema.json",
  "title": "hone protocol 1: resolved configuration",
  "description": "Level 1 configuration (`.hone/resolved.json` and the frozen snapshots under `.hone/snapshots/`). Generated by `resolve`, never edited by hand. It contains no `null`, every default is written out, and unknown keys are an error except in the namespace `x-<name>`. This schema checks the shape. The references between definitions are checked in addition, because JSON Schema cannot express them: every role in `acts`, `decides`, `actors`, and gate parameters exists; every kind in `inputs`, `outputs`, and gate parameters exists (or is `ticket`); every step in `requires` and in profiles exists; every profile in `select` exists; every gate is a standard gate, `exec`, or a key of `plugins`; every `evaluate` names a plugin; `id_prefix` is unique across kinds; `requires` has no cycles; a status in gate parameters belongs to the kind or is `superseded`, and is only given for kinds with lifecycle `decided`; the kind of `artifact-exists` and `status-is` and `binding` of `change-needs-binding` have lifecycle `decided`; the role of `approvals-valid` can `approve`.",
  "type": "object",
  "required": [
    "protocol",
    "ticket",
    "kinds",
    "roles",
    "actors",
    "steps",
    "profiles",
    "select"
  ],
  "properties": {
    "protocol": {
      "const": 1
    },
    "ticket": {
      "$ref": "#/$defs/TicketRecord"
    },
    "kinds": {
      "description": "Kinds of artifacts by name. The name `ticket` belongs to the ticket record of the core.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Key",
        "not": {
          "const": "ticket"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/Kind"
      }
    },
    "roles": {
      "description": "Roles by name: what someone may do in the process. Steps and gates name only roles, never people.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Role"
      }
    },
    "actors": {
      "description": "Handles mapped to their roles. The handle `*` is the fallback for unknown people. Without it, unknown people have no role.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/KeyList",
        "minItems": 1
      }
    },
    "steps": {
      "description": "Steps by name. The order follows from `inputs`, `outputs`, and `requires`.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Step"
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Profile"
      }
    },
    "select": {
      "$ref": "#/$defs/Select"
    },
    "plugins": {
      "description": "WASM plugins that `check` may run: gates and language plugins. Generators run only on `resolve` and are not part of this document. A plugin name must not shadow a standard gate or `exec`.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/Key",
        "not": {
          "$ref": "#/$defs/BuiltinGateName"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/Plugin"
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "$defs": {
    "KeyList": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Key"
      },
      "uniqueItems": true
    },
    "RelativePath": {
      "description": "Path with `/` as separator, relative, without `.` or `..` segments and without backslashes.",
      "type": "string",
      "pattern": "^[^/\\\\]+(/[^/\\\\]+)*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "TicketRecord": {
      "description": "Location of the ticket record, the only fixed type of the core.",
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "description": "Path of the ticket record relative to the project root (the directory that contains `.hone/`). The only placeholder is `{ticket}` (the ticket ID), exactly once.",
          "type": "string",
          "pattern": "^([^/{}\\\\]|\\{ticket\\})+(/([^/{}\\\\]|\\{ticket\\})+)*\\.yaml$",
          "allOf": [
            {
              "pattern": "\\{ticket\\}"
            },
            {
              "not": {
                "pattern": "\\{ticket\\}.*\\{ticket\\}"
              }
            },
            {
              "not": {
                "pattern": "(^|/)\\.{1,2}(/|$)"
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "KindPath": {
      "description": "Path of an artifact relative to the project root (the directory that contains `.hone/`). Placeholders: `{id}` (exactly once, in the file name, never changes), `{slug}` (at most once, in the file name, may change), `{ticket}` (at most once, only for lifecycle `decided`). No other braces. The extension selects the format: `.md` (front matter and body) or `.yaml` (data only).",
      "type": "string",
      "pattern": "^([^/{}\\\\]|\\{(id|slug|ticket)\\})+(/([^/{}\\\\]|\\{(id|slug|ticket)\\})+)*\\.(md|yaml)$",
      "allOf": [
        {
          "pattern": "\\{id\\}[^/]*$"
        },
        {
          "not": {
            "pattern": "\\{id\\}.*\\{id\\}"
          }
        },
        {
          "not": {
            "pattern": "\\{slug\\}.*\\{slug\\}"
          }
        },
        {
          "not": {
            "pattern": "\\{slug\\}.*/"
          }
        },
        {
          "not": {
            "pattern": "\\{ticket\\}.*\\{ticket\\}"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        }
      ]
    },
    "Kind": {
      "description": "A kind of artifact. Lifecycle `decided`: belongs to a ticket, has a declared status from `statuses`, a content hash, and can be approved. Lifecycle `living`: no ticket, no status, no content hash.",
      "type": "object",
      "required": ["path", "id_prefix", "lifecycle"],
      "properties": {
        "path": {
          "$ref": "#/$defs/KindPath"
        },
        "id_prefix": {
          "description": "Prefix of the artifact IDs. The prefixes of scope IDs and event IDs are reserved.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,7}$",
          "not": {
            "enum": ["tk", "ws", "prj", "dev", "ev", "th"]
          }
        },
        "lifecycle": {
          "enum": ["decided", "living"]
        },
        "schema": {
          "description": "Additional JSON Schema (draft 2020-12) of the kind, embedded by `resolve`, so that a snapshot needs no package and no other file.",
          "type": "object"
        },
        "statuses": {
          "description": "Declared statuses of the kind. A binding status makes an artifact bind agents and gates, and only a binding artifact can supersede or be superseded. `superseded` is computed and therefore reserved.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/Key",
            "not": {
              "const": "superseded"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/Status"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["lifecycle"],
            "properties": {
              "lifecycle": {
                "const": "decided"
              }
            }
          },
          "then": {
            "required": ["statuses"],
            "properties": {
              "statuses": {
                "not": {
                  "additionalProperties": {
                    "properties": {
                      "binding": {
                        "const": false
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["lifecycle"],
            "properties": {
              "lifecycle": {
                "const": "living"
              }
            }
          },
          "then": {
            "not": {
              "required": ["statuses"]
            },
            "properties": {
              "path": {
                "not": {
                  "pattern": "\\{ticket\\}"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Status": {
      "type": "object",
      "required": ["binding"],
      "properties": {
        "binding": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Role": {
      "type": "object",
      "required": ["kind", "can"],
      "properties": {
        "kind": {
          "description": "Whether the role is held by a human or an AI. Contributions of an `ai` role are labelled as such.",
          "enum": ["human", "ai"]
        },
        "can": {
          "type": "array",
          "items": {
            "enum": ["act", "comment", "approve"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Step": {
      "description": "A building block of the flow: inputs, outputs, participants as roles, and checks. Contains no instructions for a specific agent. A step is ready when its inputs are done or skipped and every step in `requires` is done or skipped.",
      "type": "object",
      "required": ["acts", "inputs", "outputs", "requires", "gates"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "acts": {
          "description": "Roles that work in the step.",
          "$ref": "#/$defs/KeyList"
        },
        "decides": {
          "description": "Role that decides the step and confirms the condensation.",
          "$ref": "common.schema.json#/$defs/Key"
        },
        "inputs": {
          "description": "Kinds the step reads. `ticket` stands for the ticket record.",
          "$ref": "#/$defs/KeyList"
        },
        "outputs": {
          "description": "Kinds the step produces.",
          "$ref": "#/$defs/KeyList"
        },
        "requires": {
          "description": "Steps that must be done or skipped first, beyond the order from inputs and outputs.",
          "$ref": "#/$defs/KeyList"
        },
        "gates": {
          "description": "Deterministic checks by a label. A map, so that a higher layer can add or remove a single gate.",
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/Key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Gate"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "BuiltinGateName": {
      "enum": [
        "artifact-exists",
        "status-is",
        "schema-valid",
        "ids-unique",
        "links-resolve",
        "no-open-blocking-threads",
        "threads-answered",
        "approvals-valid",
        "steps-complete",
        "change-needs-binding",
        "exec"
      ]
    },
    "Gate": {
      "description": "A gate entry: a standard gate, `exec`, or the name of a plugin, with parameters. `exec` belongs to the class `exec`, every other gate to the class `pure`. The standard gates `schema-valid`, `ids-unique`, and `links-resolve` check the whole checked directory, every other gate checks the ticket.",
      "type": "object",
      "required": ["gate"],
      "properties": {
        "gate": {
          "$ref": "common.schema.json#/$defs/Key"
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["gate"],
            "properties": {
              "gate": {
                "const": "artifact-exists"
              }
            }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "$ref": "#/$defs/ArtifactExistsParams"
              }
            }
          }
        },
        {
          "if": {
            "required": ["gate"],
            "properties": {
              "gate": {
                "const": "status-is"
              }
            }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "$ref": "#/$defs/StatusIsParams"
              }
            }
          }
        },
        {
          "if": {
            "required": ["gate"],
            "properties": {
              "gate": {
                "const": "threads-answered"
              }
            }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "$ref": "#/$defs/ThreadsAnsweredParams"
              }
            }
          }
        },
        {
          "if": {
            "required": ["gate"],
            "properties": {
              "gate": {
                "const": "approvals-valid"
              }
            }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "$ref": "#/$defs/ApprovalsValidParams"
              }
            }
          }
        },
        {
          "if": {
            "required": ["gate"],
            "properties": {
              "gate": {
                "const": "change-needs-binding"
              }
            }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "$ref": "#/$defs/ChangeNeedsBindingParams"
              }
            }
          }
        },
        {
          "if": {
            "required": ["gate"],
            "properties": {
              "gate": {
                "const": "exec"
              }
            }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "$ref": "#/$defs/ExecParams"
              }
            }
          }
        },
        {
          "if": {
            "required": ["gate"],
            "properties": {
              "gate": {
                "enum": [
                  "schema-valid",
                  "ids-unique",
                  "links-resolve",
                  "no-open-blocking-threads",
                  "steps-complete"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/NoneParams"
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "ArtifactExistsParams": {
      "description": "Passes if the ticket has at least one artifact of kind `type`, with `status` one whose effective status is in the set.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "$ref": "common.schema.json#/$defs/Key"
        },
        "status": {
          "$ref": "#/$defs/StatusSelector"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "StatusIsParams": {
      "description": "Passes if every artifact of kind `type` in the ticket has an effective status in the set. Passes if there is none.",
      "type": "object",
      "required": ["type", "status"],
      "properties": {
        "type": {
          "$ref": "common.schema.json#/$defs/Key"
        },
        "status": {
          "$ref": "#/$defs/StatusSelector"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "ThreadsAnsweredParams": {
      "description": "Passes if every thread opened by role `role` in the ticket is answered.",
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {
          "$ref": "common.schema.json#/$defs/Key"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "ApprovalsValidParams": {
      "description": "Passes if every artifact of the step's `outputs` with lifecycle `decided` in the ticket (only kind `type`, if given) has at least `min` approvals of role `role` whose hash matches the content. With `require_proof`, every approval needs a proof.",
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {
          "$ref": "common.schema.json#/$defs/Key"
        },
        "min": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "require_proof": {
          "type": "boolean",
          "default": false
        },
        "type": {
          "$ref": "common.schema.json#/$defs/Key"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "ChangeNeedsBindingParams": {
      "description": "Passes if, for every artifact of kind `anchored` whose anchors are hit by `changed_paths`, a binding artifact of kind `binding` names it in `affects`.",
      "type": "object",
      "required": ["anchored", "binding"],
      "properties": {
        "anchored": {
          "$ref": "common.schema.json#/$defs/Key"
        },
        "binding": {
          "$ref": "common.schema.json#/$defs/Key"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "ExecParams": {
      "description": "Runs a command of the toolchain on the host. It runs only when the lockfile approves command, working directory, and environment. Without `evaluate`, exit code 0 passes. With `evaluate`, the plugin receives the result as `tool_output` and decides alone.",
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "description": "argv list, never run through a shell.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cwd": {
          "description": "Working directory relative to the project root. Default: the project root.",
          "anyOf": [
            {
              "const": "."
            },
            {
              "$ref": "#/$defs/RelativePath"
            }
          ]
        },
        "env": {
          "description": "Names of environment variables passed to the command. Default: none.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "uniqueItems": true
        },
        "timeout_ms": {
          "description": "Time limit of the command. Default: 600000 (10 minutes).",
          "type": "integer",
          "minimum": 1
        },
        "evaluate": {
          "description": "Name of a plugin whose `check` turns the result into findings.",
          "$ref": "common.schema.json#/$defs/Key"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "StatusSelector": {
      "description": "One effective status or a set of them.",
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Key"
        },
        {
          "$ref": "#/$defs/KeyList",
          "minItems": 1
        }
      ]
    },
    "Profile": {
      "description": "Selects steps and their strictness. `required`: done or explicitly skipped. Steps not listed are not part of the flow.",
      "type": "object",
      "required": ["steps", "retention", "review_summary"],
      "properties": {
        "steps": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/Key"
          },
          "additionalProperties": {
            "enum": ["required", "optional"]
          }
        },
        "retention": {
          "description": "What happens to the raw process data after completion: `keep` (stays active), `archive` (segments kept, no longer indexed), `drop` (discarded).",
          "enum": ["keep", "archive", "drop"]
        },
        "review_summary": {
          "description": "What the condensation writes into the artifact: `full` (approvals and summary) or `approvals-only`.",
          "enum": ["full", "approvals-only"]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Scalar": {
      "type": ["string", "integer", "boolean"]
    },
    "Select": {
      "description": "Profile selection by ticket attributes. The first rule whose `when` matches wins, otherwise `default`.",
      "type": "object",
      "required": ["rules", "default"],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectRule"
          }
        },
        "default": {
          "$ref": "common.schema.json#/$defs/Key"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "SelectRule": {
      "type": "object",
      "required": ["when", "profile"],
      "properties": {
        "when": {
          "description": "Every attribute must match: a scalar by equality, a list by membership. No expression language.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/Scalar"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Scalar"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          }
        },
        "profile": {
          "$ref": "common.schema.json#/$defs/Key"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Plugin": {
      "type": "object",
      "required": ["wasm", "hash", "capabilities"],
      "properties": {
        "wasm": {
          "description": "Path of the module relative to the project root (the directory that contains `.hone/`), like every other path in this document.",
          "allOf": [
            {
              "$ref": "#/$defs/RelativePath"
            },
            {
              "pattern": "\\.wasm$"
            }
          ]
        },
        "hash": {
          "$ref": "common.schema.json#/$defs/Hash"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "Capabilities": {
      "description": "What the sandbox allows. Always explicit, the default is nothing. Plugins in this document run during `check` and are pure, so `net` must be empty.",
      "type": "object",
      "required": ["read", "net", "timeout_ms", "memory_pages"],
      "properties": {
        "read": {
          "description": "Read-only access: `project` (the checked directory) or paths relative to the project root.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "project"
              },
              {
                "$ref": "#/$defs/RelativePath"
              }
            ]
          },
          "uniqueItems": true
        },
        "net": {
          "type": "array",
          "maxItems": 0
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "memory_pages": {
          "description": "Memory limit in WASM pages of 64 KiB.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "NoneParams": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    }
  }
}
