{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hone.invalid/schema/1/plugin.schema.json",
  "title": "hone protocol 1: plugin input and output",
  "description": "The JSON that the host and a plugin exchange (concept Section 9, \"Contract\"). Input and output are UTF-8 JSON without `null`. `CheckInput` is the input of `check`, `CheckOutput` its output, and `DescribeOutput` the output of `describe`.",
  "$defs": {
    "CheckInput": {
      "type": "object",
      "required": [
        "protocol",
        "config",
        "ticket",
        "step",
        "params",
        "artifacts"
      ],
      "properties": {
        "protocol": { "const": 1 },
        "config": {
          "description": "The configuration the gate runs against: the ticket's snapshot.",
          "$ref": "config.schema.json"
        },
        "ticket": {
          "description": "The data of the ticket record.",
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/TicketId" },
            "type": { "const": "ticket" }
          }
        },
        "step": {
          "description": "The name of the step whose gate runs.",
          "$ref": "common.schema.json#/$defs/Key"
        },
        "params": {
          "description": "The `params` of the gate entry, `{}` when it has none. For a plugin named by `evaluate`, the `params` of the `exec` gate.",
          "type": "object"
        },
        "artifacts": {
          "description": "Every artifact and ticket record of the checked directory whose file passes the YAML profile.",
          "type": "array",
          "items": { "$ref": "#/$defs/Artifact" }
        },
        "changed_paths": {
          "description": "The paths the change touches, relative to the project root. Absent when the caller supplied none.",
          "type": "array",
          "items": { "type": "string" }
        },
        "tool_output": {
          "description": "Only for a plugin named by `evaluate`: the result of the command.",
          "$ref": "#/$defs/ToolOutput"
        }
      },
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "required": ["path", "data", "body"],
      "properties": {
        "path": {
          "description": "The file, relative to the project root.",
          "$ref": "config.schema.json#/$defs/RelativePath"
        },
        "status": {
          "description": "The effective status (concept Section 6). Absent when the artifact has no declared status, as with lifecycle `living`.",
          "type": "string"
        },
        "hash": {
          "description": "The content hash (spec/artifacts.md). Present exactly when the artifact's kind has lifecycle `decided`; a living artifact and a ticket record have none.",
          "$ref": "common.schema.json#/$defs/Hash"
        },
        "data": {
          "description": "The data model of the file: the front matter or the YAML document.",
          "type": "object"
        },
        "body": {
          "description": "The Markdown text after the front matter, `\"\"` for a YAML file.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ToolOutput": {
      "type": "object",
      "required": ["exit", "stdout", "stderr", "truncated"],
      "properties": {
        "exit": {
          "description": "The exit code of the command.",
          "type": "integer"
        },
        "stdout": {
          "description": "Standard output, up to 1 MiB from the start, bytes that are not UTF-8 replaced.",
          "type": "string"
        },
        "stderr": {
          "description": "Standard error, cut and replaced like `stdout`.",
          "type": "string"
        },
        "truncated": {
          "description": "`true` when `stdout` or `stderr` was cut.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "CheckOutput": {
      "type": "object",
      "required": ["findings"],
      "properties": {
        "findings": {
          "description": "The gate fails exactly when a finding has level `error`.",
          "type": "array",
          "items": { "$ref": "#/$defs/Finding" }
        }
      },
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "required": ["level", "code", "message"],
      "properties": {
        "level": { "enum": ["error", "warning"] },
        "code": {
          "description": "A code the plugin chooses.",
          "$ref": "common.schema.json#/$defs/Key"
        },
        "path": {
          "description": "The file, relative to the project root, if the finding concerns one.",
          "$ref": "config.schema.json#/$defs/RelativePath"
        },
        "pointer": {
          "description": "A JSON Pointer into the data model of the file, if the finding concerns a value.",
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)*$"
        },
        "message": {
          "description": "A human-readable explanation, not normative.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DescribeOutput": {
      "type": "object",
      "required": [
        "name",
        "version",
        "protocol",
        "entry_points",
        "capabilities"
      ],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/Key" },
        "version": { "type": "string", "minLength": 1 },
        "protocol": { "const": 1 },
        "entry_points": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "capabilities": {
          "description": "The capabilities the plugin asks for. The tool grants them, or fewer.",
          "type": "object",
          "required": ["read", "net", "timeout_ms", "memory_pages"],
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "anyOf": [
                  { "const": "project" },
                  { "$ref": "config.schema.json#/$defs/RelativePath" }
                ]
              },
              "uniqueItems": true
            },
            "net": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "timeout_ms": { "type": "integer", "minimum": 1 },
            "memory_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ResolveInput": {
      "description": "The input of `resolve` of a language plugin: every symbol of one gate run for this plugin.",
      "type": "object",
      "required": ["protocol", "state", "symbols"],
      "properties": {
        "protocol": { "const": 1 },
        "state": {
          "description": "The state the plugin reads: `project` under `/project`, `base` under `/base`.",
          "enum": ["project", "base"]
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "symbol"],
            "properties": {
              "path": { "$ref": "config.schema.json#/$defs/RelativePath" },
              "symbol": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ResolveOutput": {
      "description": "The output of `resolve`: one result per symbol, in the order of the input.",
      "type": "object",
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "const": "found" },
                  "line": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["status"],
                "properties": { "status": { "const": "missing" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["status", "message"],
                "properties": {
                  "status": { "const": "unparsable" },
                  "message": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "PublicApiInput": {
      "description": "The input of `public_api` of a language plugin: every file of one gate run and state for this plugin.",
      "type": "object",
      "required": ["protocol", "state", "paths"],
      "properties": {
        "protocol": { "const": 1 },
        "state": {
          "description": "The state the plugin reads: `project` under `/project`, `base` under `/base`.",
          "enum": ["project", "base"]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "config.schema.json#/$defs/RelativePath" }
        }
      },
      "additionalProperties": false
    },
    "PublicApiEntry": {
      "description": "One public declaration of a file. A list is never empty and a flag is present only as `true`.",
      "type": "object",
      "required": ["symbol", "kind", "text"],
      "properties": {
        "symbol": {
          "description": "The symbol as `resolve` takes it.",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "The kind of declaration, the plugin's choice.",
          "type": "string",
          "minLength": 1
        },
        "type_parameters": {
          "description": "The generic parameters in order.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceType" }
        },
        "where": {
          "description": "The predicates of a `where` clause in order.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceType" }
        },
        "receiver": {
          "description": "The receiver of a method, without a binding `mut`.",
          "$ref": "#/$defs/SourceType"
        },
        "static": {
          "description": "A member called through its type instead of an instance.",
          "const": true
        },
        "self_type": {
          "description": "The type whose implementation block holds the declaration.",
          "$ref": "#/$defs/SourceType"
        },
        "bases": {
          "description": "The supertypes in order.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceType" }
        },
        "modifiers": {
          "description": "The keywords other than visibility and `static`, compared as a set.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "attributes": {
          "description": "The attributes, decorators, and annotations, compared as a set.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceType" }
        },
        "parameters": {
          "description": "The parameters in order.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PublicApiParameter" }
        },
        "returns": {
          "description": "The return type.",
          "$ref": "#/$defs/SourceType"
        },
        "type": {
          "description": "The type of a field, constant, or variable, the target of an alias, the fields of an enum variant, or the trait of a trait implementation.",
          "$ref": "#/$defs/SourceType"
        },
        "value": {
          "description": "The value of a compile-time constant or the explicit value of an enum member.",
          "$ref": "#/$defs/SourceType"
        },
        "line": {
          "description": "The line of the declaration, counted from 1. Not compared.",
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "description": "The source text without the body, whitespace collapsed. Not compared.",
          "type": "string"
        },
        "extra": {
          "description": "Further data of the plugin. Not compared.",
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "PublicApiParameter": {
      "description": "One parameter. `name` counts only when `passing` is not `positional`; `default` never counts.",
      "type": "object",
      "required": ["name", "passing"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/SourceType" },
        "optional": {
          "description": "A caller may leave it out.",
          "const": true
        },
        "variadic": {
          "description": "It takes any number of arguments.",
          "const": true
        },
        "default": { "$ref": "#/$defs/SourceType" },
        "passing": { "enum": ["positional", "named", "both"] }
      },
      "additionalProperties": false
    },
    "SourceType": {
      "description": "Source text in token form: one space between two words and after a comma, no other space, no comma before a closing bracket.",
      "type": "string",
      "minLength": 1
    },
    "PublicApiOutput": {
      "description": "The output of `public_api`: one result per path, in the order of the input. The host compares the entries of a result through a projection: without `line`, `text`, `extra`, parameter defaults, and the names of positional parameters, as sets of canonical JSON.",
      "type": "object",
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["status", "symbols"],
                "properties": {
                  "status": { "const": "ok" },
                  "symbols": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/PublicApiEntry" }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["status", "message"],
                "properties": {
                  "status": { "const": "unparsable" },
                  "message": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
